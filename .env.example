# Copy to .env and fill in. All values are optional — without an LLM key the
# app runs in offline rule-based mode.
OPENAI_API_KEY=sk-your-key-here
# Alternative key name also accepted:
# LLM_API_KEY=
# Custom OpenAI-compatible endpoint (e.g. Azure, OpenRouter, local server):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
